# Optional AI helper. Copy this file to `.env` (which git ignores) and fill in your own values.
# With no key and model set, the AI helper stays off and the app behaves exactly as before.
# The model only translates a sentence into a plan; our code checks, runs and judges it.

# Where the OpenAI-compatible chat endpoint lives (default: a local 9router gateway).
SO_AI_BASE_URL=http://localhost:20128/v1

# Your key for that endpoint. Never commit the real one.
SO_AI_API_KEY=your-api-key-here

# The model name your endpoint should use.
SO_AI_MODEL=your-model-name

# Set to off, 0 or false to switch the helper off even when the key and model are set.
# SO_AI=off

# Seconds to wait for one answer before giving up (default 60).
# SO_AI_TIMEOUT=60
