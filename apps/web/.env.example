# FastAPI origin, used by the Next.js server proxy. Restart/rebuild after changes.
API_ORIGIN=http://127.0.0.1:8000

# Release folder pre-filled on the Start screen (absolute path to the TCGA-BRCA release, or an
# unsealed envelope's release/ folder). Optional; leave empty to type it in the app.
NEXT_PUBLIC_DEFAULT_RELEASE_DIR=
