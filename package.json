{
  "name": "second-opinion",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "node scripts/py.mjs -m uvicorn apps.api.app.main:app --reload --reload-dir apps/api --reload-dir second_opinion --host 127.0.0.1 --root-path /api",
    "build": "npm run build --workspace apps/web",
    "start:web": "npm run start --workspace apps/web",
    "start:api": "node scripts/py.mjs -m uvicorn apps.api.app.main:app --host 0.0.0.0 --root-path /api",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "node scripts/py.mjs -m pytest",
    "test:web": "npm run test --workspace apps/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
